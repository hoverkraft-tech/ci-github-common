{
	"name": "lint-pull-request-title",
	"version": "1.0.0",
	"private": true,
	"description": "Validate pull request titles with the common Conventional Commits policy",
	"type": "module",
	"scripts": {
		"test": "node --test",
		"test:ci": "node --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test"
	},
	"author": "hoverkraft",
	"license": "MIT",
	"dependencies": {
		"@commitlint/config-conventional": "21.2.3",
		"@commitlint/format": "21.2.3",
		"@commitlint/lint": "21.2.3",
		"@commitlint/load": "21.2.3"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
